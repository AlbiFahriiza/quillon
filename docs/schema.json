{
  "$defs": {
    "Anim": {
      "additionalProperties": false,
      "description": "Per-element animation. Every property is optional and independent.",
      "properties": {
        "opacity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Track"
            },
            {
              "type": "null"
            }
          ]
        },
        "rotate": {
          "anyOf": [
            {
              "$ref": "#/$defs/Track"
            },
            {
              "type": "null"
            }
          ]
        },
        "scale": {
          "anyOf": [
            {
              "$ref": "#/$defs/Track"
            },
            {
              "type": "null"
            }
          ]
        },
        "translate_x": {
          "anyOf": [
            {
              "$ref": "#/$defs/Track"
            },
            {
              "type": "null"
            }
          ]
        },
        "translate_y": {
          "anyOf": [
            {
              "$ref": "#/$defs/Track"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "Asset": {
      "description": "A referenced asset. `src` is relative to the document's directory and must\nstay inside it (no absolute paths, no `..`); `sha256`, when present, pins\nthe exact bytes.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "sha256": {
              "type": [
                "string",
                "null"
              ]
            },
            "src": {
              "type": "string"
            },
            "type": {
              "const": "image",
              "type": "string"
            }
          },
          "required": [
            "type",
            "src"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "sha256": {
              "type": [
                "string",
                "null"
              ]
            },
            "src": {
              "type": "string"
            },
            "type": {
              "const": "font",
              "type": "string"
            }
          },
          "required": [
            "type",
            "src"
          ],
          "type": "object"
        }
      ]
    },
    "ClipRect": {
      "additionalProperties": false,
      "description": "A rectangular clip in element-author coordinates: rect and image origins\nare their top-left corner, text origin is its center. The clip travels\nwith the element's transform and masks the element and its shadow.",
      "properties": {
        "h": {
          "description": "Must be > 0.",
          "format": "int64",
          "type": "integer"
        },
        "w": {
          "description": "Must be > 0.",
          "format": "int64",
          "type": "integer"
        },
        "x": {
          "format": "int64",
          "type": "integer"
        },
        "y": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "type": "object"
    },
    "Color": {
      "type": "string"
    },
    "ColorSpace": {
      "description": "Authoring color space of document colors. Format v1 accepts sRGB only.",
      "enum": [
        "srgb"
      ],
      "type": "string"
    },
    "Ease": {
      "description": "Easing curve applied to the segment that *starts* at the key carrying it\n(the last key's `ease` is ignored).",
      "enum": [
        "linear",
        "in_quad",
        "out_quad",
        "in_cubic",
        "out_cubic",
        "in_out_cubic",
        "in_quart",
        "out_quart",
        "in_back",
        "out_back"
      ],
      "type": "string"
    },
    "Element": {
      "description": "A scene element. Rendered bottom-to-top in document order.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A text block. `(x, y)` is the *center* of the laid-out text, matching the\nplan's example (title at 960, 540 on a 1920x1080 canvas).",
          "properties": {
            "align": {
              "$ref": "#/$defs/TextAlign",
              "default": "center"
            },
            "anim": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Anim"
                },
                {
                  "type": "null"
                }
              ]
            },
            "clip": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ClipRect"
                },
                {
                  "type": "null"
                }
              ]
            },
            "color": {
              "$ref": "#/$defs/Color",
              "default": "#ffffff"
            },
            "font": {
              "description": "Key of a `font` asset.",
              "type": "string"
            },
            "shadow": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ShadowDef"
                },
                {
                  "type": "null"
                }
              ]
            },
            "size": {
              "description": "Font size in pixels, (0, 512].",
              "format": "float",
              "type": "number"
            },
            "text": {
              "description": "Non-empty.",
              "type": "string"
            },
            "type": {
              "const": "text",
              "type": "string"
            },
            "x": {
              "format": "int64",
              "type": "integer"
            },
            "y": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "type",
            "text",
            "font",
            "x",
            "y",
            "size"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A solid or gradient-filled rectangle. `(x, y)` is the top-left corner.",
          "properties": {
            "anim": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Anim"
                },
                {
                  "type": "null"
                }
              ]
            },
            "clip": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ClipRect"
                },
                {
                  "type": "null"
                }
              ]
            },
            "color": {
              "$ref": "#/$defs/Color",
              "default": "#ffffff"
            },
            "gradient": {
              "anyOf": [
                {
                  "$ref": "#/$defs/GradientDef"
                },
                {
                  "type": "null"
                }
              ],
              "description": "When present, the fill is this gradient (it wins over `color`)."
            },
            "h": {
              "format": "int64",
              "type": "integer"
            },
            "radius": {
              "description": "Corner radius in pixels, clamped at render to half the shorter side.",
              "format": "float",
              "type": [
                "number",
                "null"
              ]
            },
            "shadow": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ShadowDef"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "const": "rect",
              "type": "string"
            },
            "w": {
              "format": "int64",
              "type": "integer"
            },
            "x": {
              "format": "int64",
              "type": "integer"
            },
            "y": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "type",
            "x",
            "y",
            "w",
            "h"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An image drawn into a destination box. `(x, y)` is the top-left corner.",
          "properties": {
            "anim": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Anim"
                },
                {
                  "type": "null"
                }
              ]
            },
            "asset": {
              "description": "Key of an `image` asset.",
              "type": "string"
            },
            "clip": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ClipRect"
                },
                {
                  "type": "null"
                }
              ]
            },
            "fit": {
              "$ref": "#/$defs/Fit",
              "default": "contain"
            },
            "h": {
              "format": "int64",
              "type": "integer"
            },
            "shadow": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ShadowDef"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "const": "image",
              "type": "string"
            },
            "w": {
              "format": "int64",
              "type": "integer"
            },
            "x": {
              "format": "int64",
              "type": "integer"
            },
            "y": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "type",
            "asset",
            "x",
            "y",
            "w",
            "h"
          ],
          "type": "object"
        }
      ]
    },
    "Fit": {
      "description": "How an image fills its destination box (Editly's resizeMode set, research/G §2).",
      "enum": [
        "contain",
        "cover",
        "stretch"
      ],
      "type": "string"
    },
    "GradientDef": {
      "additionalProperties": false,
      "description": "A linear gradient fill. Colors are interpolated in linear light\n(research/T); `angle` follows screen space: 0 is left-to-right, 90 is\ntop-to-bottom.",
      "properties": {
        "angle": {
          "description": "Degrees, clockwise from the +x axis.",
          "format": "float",
          "type": "number"
        },
        "stops": {
          "description": "At least two.",
          "items": {
            "$ref": "#/$defs/GradientStop"
          },
          "type": "array"
        }
      },
      "required": [
        "angle",
        "stops"
      ],
      "type": "object"
    },
    "GradientStop": {
      "additionalProperties": false,
      "description": "One color stop of a gradient. `at` is a position along the gradient axis.",
      "properties": {
        "at": {
          "description": "In [0, 1]; stops must be strictly increasing in `at`.",
          "format": "float",
          "type": "number"
        },
        "color": {
          "$ref": "#/$defs/Color"
        }
      },
      "required": [
        "at",
        "color"
      ],
      "type": "object"
    },
    "Key": {
      "additionalProperties": false,
      "description": "One keyframe. `ease` applies to the segment starting at this key.",
      "properties": {
        "ease": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ease"
            },
            {
              "type": "null"
            }
          ]
        },
        "t": {
          "description": "Scene-local time in ticks, `>= 0` and `<=` the scene duration.",
          "format": "int64",
          "type": "integer"
        },
        "v": {
          "description": "Animated value: opacity in [0,1]; translate in px; scale around 1.0;\nrotation in degrees.",
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "t",
        "v"
      ],
      "type": "object"
    },
    "Scene": {
      "additionalProperties": false,
      "description": "A scene: `duration` ticks, elements stacked bottom-to-top.",
      "properties": {
        "duration": {
          "description": "In ticks, `> 0`.",
          "format": "int64",
          "type": "integer"
        },
        "elements": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Element"
          },
          "type": "array"
        },
        "id": {
          "description": "Unique, non-empty, at most 128 bytes.",
          "type": "string"
        },
        "transition_in": {
          "anyOf": [
            {
              "$ref": "#/$defs/Transition"
            },
            {
              "type": "null"
            }
          ],
          "description": "How this scene enters; `None` means a hard cut. Only meaningful from\nthe second scene on (the first scene cannot fade from anything)."
        }
      },
      "required": [
        "id",
        "duration"
      ],
      "type": "object"
    },
    "ShadowDef": {
      "additionalProperties": false,
      "description": "A drop shadow cast by an element's silhouette, blurred in linear light\nand composited under the element.",
      "properties": {
        "alpha": {
          "default": 1.0,
          "description": "Shadow opacity in [0, 1].",
          "format": "float",
          "type": "number"
        },
        "blur": {
          "description": "Blur radius in pixels, [0, 512].",
          "format": "float",
          "type": "number"
        },
        "color": {
          "$ref": "#/$defs/Color"
        },
        "offset_x": {
          "description": "Horizontal offset in pixels, right-positive.",
          "format": "float",
          "type": "number"
        },
        "offset_y": {
          "description": "Vertical offset in pixels, down-positive.",
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "offset_x",
        "offset_y",
        "blur",
        "color"
      ],
      "type": "object"
    },
    "Size": {
      "additionalProperties": false,
      "description": "Canvas size in pixels.",
      "properties": {
        "h": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "w": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "w",
        "h"
      ],
      "type": "object"
    },
    "TextAlign": {
      "description": "Horizontal text alignment within its line box.",
      "enum": [
        "left",
        "center",
        "right"
      ],
      "type": "string"
    },
    "Track": {
      "additionalProperties": false,
      "description": "A keyframe track for one animatable property.",
      "properties": {
        "keys": {
          "description": "At least two, strictly increasing in `t`.",
          "items": {
            "$ref": "#/$defs/Key"
          },
          "type": "array"
        }
      },
      "required": [
        "keys"
      ],
      "type": "object"
    },
    "Transition": {
      "additionalProperties": false,
      "description": "The transition into a scene. It consumes the head of the incoming scene;\nthe timeline stays the sum of scene durations (no overlap arithmetic).",
      "properties": {
        "duration": {
          "description": "In ticks. `0` for a cut; for a crossfade, `> 0` and `<=` the scene\nduration.",
          "format": "int64",
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/TransitionKind"
        }
      },
      "required": [
        "kind",
        "duration"
      ],
      "type": "object"
    },
    "TransitionKind": {
      "description": "How a scene enters: a hard cut (the default) or a crossfade blended in\nlinear light over the previous scene's continuing frames.",
      "enum": [
        "cut",
        "crossfade"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The root document.",
  "properties": {
    "assets": {
      "additionalProperties": {
        "$ref": "#/$defs/Asset"
      },
      "default": {},
      "type": "object"
    },
    "bg": {
      "$ref": "#/$defs/Color",
      "default": "#000000"
    },
    "bit_depth": {
      "default": 8,
      "format": "uint8",
      "maximum": 255,
      "minimum": 0,
      "type": "integer"
    },
    "color_space": {
      "$ref": "#/$defs/ColorSpace",
      "default": "srgb"
    },
    "fps": {
      "default": 30,
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "scenes": {
      "items": {
        "$ref": "#/$defs/Scene"
      },
      "type": "array"
    },
    "size": {
      "$ref": "#/$defs/Size"
    },
    "timebase": {
      "default": 705600000,
      "format": "int64",
      "type": "integer"
    },
    "v": {
      "description": "Format version; `1` for this build.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "v",
    "size",
    "scenes"
  ],
  "title": "Document",
  "type": "object"
}
